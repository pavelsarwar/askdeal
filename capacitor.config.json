{
  "appId": "my.com.askdeal.app",
  "appName": "Ask Deal",
  "webDir": "www",
  "server": {
    "url": "https://askdeal.com.my",
    "cleartext": false,
    "allowNavigation": ["askdeal.com.my", "www.askdeal.com.my"]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#ffffff",
      "overlaysWebView": false
    }
  }
}